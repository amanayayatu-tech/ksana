# ksana IC / ResearchOS local environment template.
# Copy this file to .env and fill only the provider fields you need.
# Do not commit a real .env file.

# LLM_PROVIDER options:
# - local: deterministic fallback / no external LLM calls
# - openai: use OPENAI_API_KEY with the OpenAI API
# - codex_cli: use the local Codex CLI login/session as an LLM provider
LLM_PROVIDER=local
LLM_MODEL=gpt-5.5

# Required only when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Optional Codex CLI provider tuning.
CODEX_PROVIDER_REASONING_EFFORT=low
CODEX_PROVIDER_TIMEOUT_SECONDS=120

# Local data and methodology roots.
DATA_DIR=data
METHODOLOGIES_DIR=methodologies

# Local notifications and run logging.
NOTIFIER_CHANNELS=local
LOG_LEVEL=INFO
LOG_PATH=data/orchestrator/logs
ORCHESTRATOR_DB_PATH=data/orchestrator/runs.db

# Web UI defaults.
WEBUI_HOST=127.0.0.1
WEBUI_PORT=7777

# Research policy configuration.
OPPORTUNITY_SCORING_CONFIG=orchestrator/config/opportunity_scoring.yaml
RISK_BUDGET_POLICY_CONFIG=orchestrator/config/risk_budget_policy.yaml
